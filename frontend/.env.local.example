# WalletConnect Cloud project id (https://cloud.walletconnect.com). Optional
# for local dev -- browser-extension wallets (MetaMask, etc.) work without
# it. Only the WalletConnect QR/remote-config path needs a real value.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed Helm contract address on Bradbury. Set automatically by
# deploy/001_deploy_helm.ts (written into lib/contracts.ts) -- this env var
# is an optional override for pointing the frontend at a different deploy
# (e.g. a local Studio instance) without editing contracts.ts.
NEXT_PUBLIC_HELM_CONTRACT_ADDRESS=
